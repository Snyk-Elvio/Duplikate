# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# Format: postgres://user:pass@host:port/dbname
DATABASE_URL=postgres://duplikate:duplikate@db:5432/duplikate

# ---- CORS ----
# Comma-separated. For a Chrome extension this is chrome-extension://<extension-id>
CORS_ALLOWED_ORIGINS=chrome-extension://your-extension-id-here

# ---- Salesforce ----
# The Lightning domain the content script runs on, e.g. yourcompany.lightning.force.com
SFDC_DOMAIN=yourcompany.lightning.force.com

# ---- Auth ----
# Access token lifetime in days (design spec: 7)
JWT_ACCESS_TOKEN_LIFETIME_DAYS=7
